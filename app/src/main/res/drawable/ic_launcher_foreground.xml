<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Satellite, rotated so the solar panels run along the diagonal -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">
        <!-- solar panels -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M26,47 L44,47 L44,61 L26,61 Z" />
        <path
            android:fillColor="#00E5FF"
            android:pathData="M64,47 L82,47 L82,61 L64,61 Z" />
        <!-- panel grid -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="1"
            android:pathData="M32,47 L32,61 M38,47 L38,61 M70,47 L70,61 M76,47 L76,61 M26,54 L44,54 M64,54 L82,54" />
        <!-- arms -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44,53 L47,53 L47,55 L44,55 Z M61,53 L64,53 L64,55 L61,55 Z" />
        <!-- body -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M47,43 L61,43 L61,65 L47,65 Z" />
        <!-- dish -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M48,66 A6,6 0 0,0 60,66 Z" />
        <!-- small antenna on top -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M54,43 L54,37" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,34.5 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
    </group>

    <!-- Sensor / signal waves towards the ground -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M68,68 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M75,68 A7,7 0 0,1 68,75" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M80,68 A12,12 0 0,1 68,80" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M85,68 A17,17 0 0,1 68,85" />
</vector>
